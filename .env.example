# SQL MCP Server example environment.
# Copy to .env for local development and replace placeholder DSNs as needed.

# Default database. The in-memory SQLite DSN is safe for a first run.
DATABASE_URL=sqlite://:memory:
INSTANCE_NAME=sql-mcp

# Network listen address. Leave empty to use stdio.
LISTEN=:8088

# Optional default connection pool settings.
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=1

# Optional multi-database routing.
# Each DATABASE_{ID}_URL creates /db/{id}/mcp and /db/{id}/sse routes.
# DATABASE_APP_URL=sqlite:///app/data/app.db
# DATABASE_APP_NAME=app-db
# DATABASE_APP_MAX_OPEN_CONNS=10
# DATABASE_APP_MAX_IDLE_CONNS=1
#
# DATABASE_REPORTING_URL=postgres://user:pass@postgres:5432/reporting
# DATABASE_REPORTING_NAME=reporting-db
#
# DATABASE_EVENTS_URL=clickhouse://user:pass@clickhouse:9000/events
# DATABASE_TIDB_URL=tidb://user:pass@tidb:4000/app
# DATABASE_DORIS_URL=doris://user:pass@doris-fe:9030/warehouse
# DATABASE_OB_URL=oceanbase://user:pass@oceanbase:3306/app
# DATABASE_ROACH_URL=cockroach://user:pass@cockroach:26257/app
#
# DEFAULT_DATABASE=APP
