# SQL MCP Server example environment.
# Copy to .env for local development and replace placeholder DSNs as needed.

# Default database. There is no built-in fallback: without DB_URL (or DB_{ID}_URL)
# the server refuses to start. Uncomment one of the examples below.
# DB_URL=sqlite:///app/data/sql-mcp.db
# DB_URL=postgres://user:pass@localhost:5432/app

DB_NAME=sql-mcp

# Optional short purpose note shown to the model in MCP tool descriptions.
# It is rendered as quoted, informational text; keep it to one line.
# DB_MEMO=Primary application database

# Network listen address. Leave empty to use stdio.
LISTEN=:8088

# Optional HTTP/SSE authentication token.
# Use Authorization: Bearer <token> when possible; ?token=<token> is accepted as a fallback.
# AUTH_TOKEN=change-me

# Optional default connection pool settings.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=1

# Optional multi-database routing.
# Each DB_{ID}_URL creates /db/{id}/mcp and /db/{id}/sse routes.
# DB_APP_URL=sqlite:///app/data/app.db
# DB_APP_NAME=app-db
# DB_APP_MEMO=Primary application database
# DB_APP_MAX_OPEN_CONNS=10
# DB_APP_MAX_IDLE_CONNS=1
#
# DB_REPORTING_URL=postgres://user:pass@postgres:5432/reporting
# DB_REPORTING_NAME=reporting-db
# DB_REPORTING_MEMO=Analytics and BI replica
#
# DB_EVENTS_URL=clickhouse://user:pass@clickhouse:9000/events
# DB_TIDB_URL=tidb://user:pass@tidb:4000/app
# DB_DORIS_URL=doris://user:pass@doris-fe:9030/warehouse
# DB_OB_URL=oceanbase://user:pass@oceanbase:3306/app
# DB_ROACH_URL=cockroach://user:pass@cockroach:26257/app
#
# DEFAULT_DB=APP
